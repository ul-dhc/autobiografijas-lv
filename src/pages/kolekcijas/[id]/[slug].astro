---
import CollectionDetail from '../../../components/CollectionDetail.astro';
import { catalogue } from '../../../data/catalogue';
import { collectionSlug } from '../../../data/collection-slug.mjs';
export function getStaticPaths() { return catalogue.map(collection => ({ params: { id: collection.id, slug: collectionSlug(collection.title.lv) }, props: { collection } })); }
const { collection } = Astro.props;
---
<CollectionDetail collection={collection} lang="lv" />
