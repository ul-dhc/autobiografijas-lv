---
import LucideIcon from "./LucideIcon.astro";
import type { Lang } from "../data/urls";
import { localUrl } from "../data/urls";
import { catalogueUrl } from '../data/catalogue';
interface Props { lang: Lang; subpage?: boolean; alternatePath?: string; }
const { lang } = Astro.props;
const en = lang === "en";
const sectionUrl = (id: string) => `${Astro.props.subpage ? localUrl(en ? 'en/' : '') : ''}#${id}`;
---
<header class={"shell masthead"} data-mobile-header>
  <button class="mobile-menu-toggle" type="button" aria-controls="main-navigation" aria-expanded="false" data-menu-toggle hidden><span class="menu-open-icon"><LucideIcon name="menu" /></span><span class="menu-close-icon"><LucideIcon name="x" /></span>{en ? "Menu" : "Izvēlne"}</button>
  <nav id="main-navigation" aria-label={en ? "Main navigation" : "Galvenā navigācija"}>
    {Astro.props.subpage && <a href={localUrl(en ? 'en/' : '')}>{en ? 'Home' : 'Sākums'}</a>}
    <a href={catalogueUrl(lang)} aria-current={Astro.props.subpage ? 'page' : undefined}>
      {en ? "Collections" : "Kolekcijas"}
    </a>
    <a href={sectionUrl('research')}>
      {en ? "Research" : "Pētniecībai"}
    </a>
    <a href={sectionUrl('creators')}>
      {en ? "Team" : "Komanda"}
    </a>
    <a href={sectionUrl('supporters')}>
      {en ? "Supporters" : "Atbalstītāji"}
    </a>
    <a href={"#contact"}>
      {en ? "Contact" : "Kontakti"}
    </a>
  </nav>
  <div class={"header-tools"}>
    <button class={"text-size"} type={"button"} aria-label={en ? "Increase text size" : "Palielināt tekstu"} title={en ? "Increase text size" : "Palielināt tekstu"} aria-pressed={"false"}>
      {"A+"}
    </button>
    <a class={"language"} data-language-link href={Astro.props.alternatePath !== undefined ? localUrl(Astro.props.alternatePath) : en ? localUrl() : localUrl("en/")} lang={en ? "lv" : "en"} aria-label={en ? "Latviski" : "In English"}>
      {en ? "LV" : "EN"}
    </a>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-mobile-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  if (header && toggle) {
    const mobile = matchMedia('(max-width: 850px)');
    const setOpen = (open: boolean) => {
      header.dataset.menuOpen = String(open);
      toggle.setAttribute('aria-expanded', String(open));
    };
    setOpen(false);
    toggle.hidden = false;
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    header.querySelectorAll('nav a').forEach(link => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('click', event => { if (!header.contains(event.target as Node)) setOpen(false); });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    mobile.addEventListener('change', () => setOpen(false));
  }
</script>
