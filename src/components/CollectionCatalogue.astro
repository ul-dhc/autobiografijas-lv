---
import BaseLayout from '../layouts/BaseLayout.astro';
import CatalogueImage from './CatalogueImage.astro';
import LucideIcon from './LucideIcon.astro';
import { catalogue, cataloguePath, collectionUrl, localizedText, materialLabels, periodLabel, searchText } from '../data/catalogue';
import { localUrl, type Lang } from '../data/urls';
import '../styles/catalogue.css';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const en = lang === 'en';
---
<BaseLayout lang={lang} subpage pageTitle={en ? 'Collections | Autobiography Collection' : 'Kolekcijas | Autobiogrāfiju krājums'} pageDescription={en ? 'Explore diaries, life stories, memoirs and letters in the Autobiography Collection.' : 'Meklē dienasgrāmatas, dzīvesstāstus, atmiņas un vēstules Autobiogrāfiju krājuma kolekcijās.'} lvPath={cataloguePath('lv')} enPath={cataloguePath('en')}>
  <section class="shell catalogue" data-catalogue data-lang={lang}>
    <div class="catalogue-intro">
      <a class="catalogue-back" href={localUrl(en ? 'en/' : '')}><LucideIcon name="arrow-left" /> {en ? 'Autobiography Collection' : 'Autobiogrāfiju krājums'}</a>
      <div class="catalogue-heading"><div><h1>{en ? 'Collections' : 'Kolekcijas'}</h1><p>{en ? 'Personal writings across generations. Discover diaries, life stories, memoirs and letters.' : 'Dzīves pieraksti no dažādiem laikmetiem. Iepazīsti dienasgrāmatas, dzīvesstāstus, atmiņas un vēstules.'}</p></div><span class="catalogue-total"><strong>{catalogue.length}</strong>{en ? 'collections' : 'kolekcija'}</span></div>
    </div>
    <form class="catalogue-controls" data-catalogue-controls hidden role="search">
      <div class="catalogue-search-field"><label for="catalogue-query">{en ? 'Search collections' : 'Meklēt kolekcijās'}</label><div class="catalogue-input-wrap"><LucideIcon name="search" /><input id="catalogue-query" name="q" type="search" placeholder={en ? 'Title, description or name…' : 'Nosaukums, apraksts vai personas vārds…'} autocomplete="off" /></div></div>
      <fieldset class="catalogue-type-options"><legend>{en ? 'Material types' : 'Materiālu veidi'}</legend>{Object.entries(materialLabels).map(([value, labels]) => <label><input type="checkbox" name="type" value={value} /><span>{labels[lang]}</span></label>)}<p>{en ? 'Collections must include all selected types.' : 'Kolekcijai jāietver visi izvēlētie veidi.'}</p></fieldset>
      <div><label for="catalogue-sort">{en ? 'Sort by' : 'Kārtot pēc'}</label><select id="catalogue-sort" name="sort"><option value="number">{en ? 'Collection number' : 'Kolekcijas numura'}</option><option value="title">{en ? 'Title: A–Z' : 'Nosaukuma: A–Z'}</option><option value="year">{en ? 'Writing period' : 'Rakstīšanas laika'}</option></select></div>
    </form>
    <div class="catalogue-results-bar"><p data-catalogue-count role="status" aria-live="polite">{en ? `${catalogue.length} collections` : `${catalogue.length} kolekcija`}</p><div class="catalogue-result-actions" data-catalogue-actions hidden><button type="button" class="catalogue-reset" data-catalogue-reset hidden>{en ? 'Clear filters' : 'Notīrīt filtrus'}</button><div class="catalogue-view" role="group" aria-label={en ? 'View' : 'Skats'}><button type="button" data-catalogue-view="grid" aria-pressed="true" aria-label={en ? 'Card view' : 'Kartīšu skats'} title={en ? 'Card view' : 'Kartīšu skats'}><LucideIcon name="layout-grid" /></button><button type="button" data-catalogue-view="list" aria-pressed="false" aria-label={en ? 'List view' : 'Saraksta skats'} title={en ? 'List view' : 'Saraksta skats'}><LucideIcon name="list" /></button></div></div></div>
    <noscript><p>{en ? 'All collections are listed below. Enable JavaScript to use the search and filters.' : 'Zemāk ir visas kolekcijas. Meklēšanai un filtriem nepieciešams JavaScript.'}</p></noscript>
    <div class="catalogue-grid" data-catalogue-grid data-view="grid">
      {catalogue.map(collection => {
        const title = localizedText(collection.title, lang);
        const description = localizedText(collection.shortDescription, lang);
        const people = collection.authors.length ? collection.authors : collection.submitters;
        return <article class="catalogue-card" data-catalogue-card data-search={searchText(collection)} data-types={collection.materialTypes.join(',')} data-number={collection.number} data-title={title.text} data-year={collection.writingPeriod.start ?? ''}>
          <a class="catalogue-card-image" href={collectionUrl(collection.id, lang)} data-collection-link aria-label={title.text}><CatalogueImage collection={collection} lang={lang} /></a>
          <div class="catalogue-card-copy"><div class="catalogue-card-meta"><span>{collection.reference}</span>{periodLabel(collection, lang) && <span>{periodLabel(collection, lang)}</span>}</div><h2><a href={collectionUrl(collection.id, lang)} data-collection-link lang={title.lang}>{title.text}</a></h2>
            {description.text && <p class="catalogue-card-description" lang={description.lang}>{description.text}</p>}
            {people.length > 0 && <p class="catalogue-card-people"><span>{collection.authors.length ? (en ? 'Author: ' : 'Autors: ') : (en ? 'Submitted by: ' : 'Iesniedzējs: ')}</span>{people.join(', ')}</p>}
            <a class="catalogue-card-more" href={collectionUrl(collection.id, lang)} data-collection-link>{en ? 'Explore collection' : 'Iepazīt kolekciju'} <LucideIcon name="chevron-right" /></a>
          </div>
        </article>;
      })}
    </div>
    <div class="catalogue-empty" data-catalogue-empty hidden><h2>{en ? 'No collections found' : 'Neviena kolekcija nav atrasta'}</h2><p>{en ? 'Try a shorter phrase or choose another material type.' : 'Pamēģini īsāku meklēšanas frāzi vai izvēlies citu materiāla veidu.'}</p><button type="button" data-catalogue-reset>{en ? 'Show all collections' : 'Rādīt visas kolekcijas'}</button></div>
    <div class="catalogue-load" data-catalogue-load hidden><p data-catalogue-visible></p><button type="button" data-catalogue-more>{en ? 'Show more collections' : 'Rādīt vairāk kolekciju'}</button></div>
  </section>
  <script>import '../scripts/catalogue.js';</script>
</BaseLayout>
