---
import type { Lang } from "../data/urls";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const en = lang === "en";
const sources = import.meta.glob<{ default: ImageMetadata }>('../assets/*.{jpg,png}', { eager: true });
const descriptions = [
  ['Sena rokraksta lapa', 'An early handwritten manuscript page'],
  ['Dienasgrāmatas atvērums ar zilu rokrakstu', 'A diary spread written in blue ink'],
  ['Ilustrēta dienasgrāmata ar izgriezumiem', 'An illustrated diary with pasted clippings'],
  ['Dienasgrāmatas kolāža ar fotogrāfijām un pastmarkām', 'A diary collage with photographs and stamps'],
  ['Rokraksts rūtiņu kladē', 'Handwriting in a squared notebook'],
  ['Dienasgrāmatas atvērums, 1936. gads', 'A diary spread from 1936'],
  ['Dienasgrāmatas atvērums, 1987. gada vasara', 'A diary spread from the summer of 1987'],
  ['Dienasgrāmatas atvērums ar sievietes zīmējumu', 'A diary spread with a drawing of a woman'],
  ['Atmiņu pieraksti rūtiņu kladē', 'Memoir notes in a squared notebook'],
  ['Vēsturiska vīrieša portretfotogrāfija', 'A historical portrait photograph of a man'],
  ['Ilustrēta rokraksta lapa ar Ziemassvētku eglīti', 'An illustrated manuscript page with a Christmas tree'],
  ['Atmiņu pierakstu atvērums', 'A spread of handwritten memoir notes'],
  ['Vēsturiska ģimenes portretfotogrāfija', 'A historical family portrait'],
  ['Vēsturiska pāra fotogrāfija', 'A historical photograph of a couple'],
  ['Ģimene dārzā', 'A family in a garden'],
  ['Rokraksta lapa ar atmiņu pierakstiem', 'A manuscript page of memoir notes'],
  ['Meitene ar kazu', 'A girl with a goat'],
  ['Vīrieša portrets ar atvērtu grāmatu', 'A portrait of a man with an open book'],
  ['Četri cilvēki dabā', 'Four people outdoors'],
  ['Laiva ar cilvēkiem un mantām', 'A boat carrying people and belongings'],
  ['Skolnieces portretfotogrāfija', 'A portrait photograph of a schoolgirl'],
  ['Meitene lasa šūpuļtīklā', 'A girl reading in a hammock'],
  ['Jaunieša portretfotogrāfija', 'A portrait photograph of a young person'],
  ['Vīrietis raksta pie galda', 'A man writing at a desk'],
  ['Sieviete ar motociklu mežā', 'A woman with a motorcycle in a forest'],
];
const files = ['elma-portrait.jpg', 'irma-cover.jpg', ...descriptions.map((_, i) => `hero-archive-${String(i + 1).padStart(2, '0')}.png`)];
const images = await Promise.all(files.map(async (file, index) => {
  const source = sources[`../assets/${file}`].default;
  const optimized = await getImage({ src: source, width: Math.min(800, source.width), format: 'webp', quality: 82 });
  const alt = index === 0 ? (en ? 'Photograph from the Elma Marija Vanags collection' : 'Fotogrāfija no Elmas Marijas Vanags kolekcijas') : index === 1 ? (en ? 'A diary cover' : 'Dienasgrāmatas vāks') : descriptions[index - 2][en ? 1 : 0];
  return { src: optimized.src, width: source.width, height: source.height, alt, portrait: source.height > source.width };
}));
const defaults = [images[0], images[4], images[11], images[5]];
const frameClasses = ["album-cover", "album-child", "album-detail", "album-note"];

---
<section class={"shell hero"}>
  <div class={"hero-copy"}>
    <h1>
      {en ? <Fragment>ALF Autobiography<br />Collection</Fragment> : <Fragment><span class="title-prefix">Latviešu folkloras krātuves</span>Autobiogrāfiju<br />krājums</Fragment>}
    </h1>
    <p class={"intro"}>
      {en ? "A collection of the Archives of Latvian Folklore at the Institute of Literature, Folklore and Art, University of Latvia, jointly developed with the Digital Humanities Centre at the University of Latvia Faculty of Humanities." : "LU LFMI Latviešu folkloras krātuves kolekcija, kuru kopīgi veido LU LFMI Latviešu folkloras krātuve un LU HZF Digitālo humanitāro zinātņu centrs."}
    </p>
    <a class="read-link hero-about" href="#about">{en ? 'About the collection' : 'Par krājumu'}</a>
    <div class={"hero-links"}>
      <a class={"primary"} href={"#archive"}>
        {en ? "Read the collection" : "Lasīt krājumu"}
      </a>
      <a class={"read-link"} href={"#contribute"}>
        {en ? "Contribute your materials" : "Iesniegt savus materiālus"}
      </a>
    </div>
  </div>
  <div class="album" data-collage="0" data-collage-images={JSON.stringify(images)}>
    {defaults.map((image, index) => (
      <figure class={frameClasses[index]}>
        <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="eager" decoding="async" />
      </figure>
    ))}
  </div>
</section>

<script>
  type CollageImage = { src: string; width: number; height: number; alt: string; portrait: boolean };
  const collage = document.querySelector<HTMLElement>('[data-collage-images]');
  if (collage) {
    const images: CollageImage[] = JSON.parse(collage.dataset.collageImages || '[]');
    const shuffled = (items: CollageImage[]) => {
      const result = [...items];
      for (let i = result.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [result[i], result[j]] = [result[j], result[i]];
      }
      return result;
    };
    const portraits = shuffled(images.filter(image => image.portrait));
    const spreads = shuffled(images.filter(image => !image.portrait));
    let selected = [portraits[0], spreads[0], portraits[1], spreads[1]];
    try {
      const key = selected.map(image => image.src).join('|');
      if (sessionStorage.getItem('hero-collage-pair') === key) selected[3] = spreads[2];
      sessionStorage.setItem('hero-collage-pair', selected.map(image => image.src).join('|'));
    } catch { /* Random selection also works when browser storage is unavailable. */ }
    selected.forEach((image, index) => {
      const element = collage.querySelectorAll('img')[index];
      element.src = image.src;
      element.alt = image.alt;
      element.width = image.width;
      element.height = image.height;
    });
    collage.dataset.collage = String(Math.floor(Math.random() * 3));
  }
</script>
