---
import type { Lang } from "../data/urls";
import DiaryExamples from "./DiaryExamples.astro";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const en = lang === "en";
---
<section id={"pudelis"} class={"shell social-feature"}>
  <DiaryExamples lang={lang} />
  <div>
    <p class={"social-kicker"}>
      {en ? "A diary on social media" : "Dienasgrāmata sociālajos tīklos"}
    </p>
    <h2>
      {en ? "Emīls Pudelis writes… for decades" : "Emīls Pudelis raksta… gadu desmitiem"}
    </h2>
    <p class={"social-lead"}>
      {en ? "Entry by entry, a hundred years later." : "Ieraksts pēc ieraksta – ar simt gadu nobīdi."}
    </p>
    <p>
      {en ? "Emīls Pudelis, a farmer from Mazsalaca, kept a diary for decades. Since 2018, we have been publishing his entries on social media one hundred years after they were written. Daily work, weather and events reveal the rhythm of his life." : "Mazsalacas saimnieks Emīls Pudelis dienasgrāmatu rakstīja gadu desmitiem. Kopš 2018. gada viņa ierakstus publicējam sociālajos tīklos ar simt gadu nobīdi. Ikdienas darbi, laikapstākļi un notikumi ļauj sekot viņa dzīves ritmam."}
    </p>
    <div class={"social-actions"}>
      <a class={"primary"} href={"https://www.facebook.com/pudelisraksta/"} target="_blank" rel="noopener noreferrer">
        {en ? "Read on Facebook" : "Lasīt Facebook"}
      </a>
      <a class={"secondary"} href={"https://twitter.com/pudelis_raksta"} target="_blank" rel="noopener noreferrer">
        {en ? "Read on X" : "Lasīt X"}
      </a>
    </div>
    <a class={"read-link"} href={en ? "https://garamantas.lv/en/collection/1119254" : "https://garamantas.lv/lv/collection/1119254"} target="_blank" rel="noopener noreferrer">
      {en ? "Original diaries on garamantas.lv" : "Dienasgrāmatas oriģināli garamantas.lv"}
    </a>
  </div>
</section>
