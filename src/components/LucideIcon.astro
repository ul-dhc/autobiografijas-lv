---
import icons from '../data/lucide-icons.json';
interface Props { name: keyof typeof icons; }
const { name } = Astro.props;
---
<svg class="lucide-icon" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[name].body} />
