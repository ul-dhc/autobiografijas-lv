---
import '../styles/global.css';
import '../styles/interaction.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { localUrl, type Lang } from '../data/urls';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const en = lang === 'en';
const title = en ? 'ALF Autobiography Collection' : 'Latviešu folkloras krātuves Autobiogrāfiju krājums';
const description = en
  ? 'Diaries, life stories, memoirs and letters. A collection jointly developed by the Archives of Latvian Folklore and the University of Latvia Digital Humanities Centre.'
  : 'Dienasgrāmatas, dzīvesstāsti, atmiņas un vēstules. LU LFMI Latviešu folkloras krātuves un LU HZF Digitālo humanitāro zinātņu centra kopīgi veidota kolekcija.';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title><meta name="description" content={description} />
    <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:locale" content={en ? 'en_GB' : 'lv_LV'} />
    {canonical && <link rel="canonical" href={canonical} />}
    {Astro.site && <><link rel="alternate" hreflang="lv" href={new URL(localUrl(), Astro.site)} /><link rel="alternate" hreflang="en" href={new URL(localUrl('en/'), Astro.site)} /></>}
    <link rel="icon" type="image/svg+xml" href={localUrl('favicon.svg')} />
  </head>
  <body>
    <a class="skip" href="#main">{en ? 'Skip to content' : 'Pāriet uz saturu'}</a>
    <Header lang={lang} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
    <script>import '../scripts/interactions.js';</script>
  </body>
</html>
